{
  "name": "splunk-adm",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && vite build --config vite.splunk.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint frontend/src vite*.ts tools/package-app.mjs && tsc --noEmit && prettier --check frontend tools/package-app.mjs eslint.config.mjs \"*.ts\" \"*.json\"",
    "format": "prettier --write frontend tools/package-app.mjs eslint.config.mjs \"*.ts\" \"*.json\"",
    "package": "npm run build && node tools/package-app.mjs",
    "test": "vitest run",
    "test:browser": "playwright test",
    "typecheck:browser": "tsc -p tsconfig.browser.json --noEmit"
  },
  "dependencies": {
    "@splunk/react-time-range": "12.1.1",
    "@splunk/react-ui": "5.17.0",
    "@splunk/search-job": "3.1.0",
    "@splunk/splunk-utils": "4.1.0",
    "@splunk/themes": "1.13.0",
    "lucide-react": "1.52.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "styled-components": "5.3.11"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/styled-components": "^5.1.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.6.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
