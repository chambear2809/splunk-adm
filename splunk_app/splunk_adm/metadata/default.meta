access = read : [ adm_investigate, adm_viewer, admin, sc_admin ], write : [ admin, sc_admin ]

# ---- Change verification ----
[collections/adm_change_assertions]
access = read : [ adm_investigate, adm_viewer, admin, sc_admin ], write : [ admin, sc_admin ]
# ---- End change verification ----

