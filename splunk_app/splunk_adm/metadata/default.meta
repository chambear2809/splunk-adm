# App objects and derived lookups/collections expose data aggregated from every
# configured source index. Readers must hold adm_viewer (inherited by
# adm_investigate) or be administrators; see docs/SECURITY.md.
[]
access = read : [ adm_investigate, adm_viewer, admin, sc_admin ], write : [ admin, sc_admin ]
export = none

