[]
access = read : [ * ], write : [ admin, sc_admin ]
export = none

[collections/adm_deployment_settings]
access = read : [ * ], write : [ admin, sc_admin ]

[collections/adm_observer_scope]
access = read : [ * ], write : [ admin, sc_admin ]

[collections/adm_network_source_scope]
access = read : [ * ], write : [ admin, sc_admin ]

[collections/adm_network_client_history]
access = read : [ * ], write : [ admin, sc_admin ]

[collections/adm_cilium_cluster_settings]
