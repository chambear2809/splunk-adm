access = read : [ * ], write : [ admin, sc_admin ]

[transforms/adm_cilium_cluster_settings]
access = read : [ * ], write : [ admin, sc_admin ]

# All saved searches in this app write derived state or perform maintenance.
# Read access permits dispatchAs=owner, so these are administrator-only.
[savedsearches]
access = read : [ admin, sc_admin ], write : [ admin, sc_admin ]

[alert_actions/adm_recovery]
access = read : [ admin, sc_admin ], write : [ admin, sc_admin ]

