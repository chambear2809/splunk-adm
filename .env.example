# Private file: ~/.splunk/labs/atlas-deployment/credentials/.env
# Private local operator credentials. Keep outside every repository.
# Dotenv data, not shell code: load without interpolation; do not source.
# Passwords not verified for this exact target are intentionally blank.

# Splunk Cloud: current stack only; current API access uses the token file
SPLUNK_CLOUD_API_AUTH_METHOD=""
SPLUNK_CLOUD_STACK=""
SPLUNK_CLOUD_WEB_URL=""
SPLUNK_CLOUD_API_URL=""
SPLUNK_CLOUD_USERNAME=""
SPLUNK_CLOUD_PASSWORD=""
SPLUNK_CLOUD_API_TOKEN_FILE=""

# Splunk.com: separate account used for app-upload validation
SPLUNK_COM_USERNAME=""
SPLUNK_COM_PASSWORD=""

# Heavy forwarder: Splunk management account
# Management API is loopback-only on the HF; use the existing SSH transport.
SPLUNK_HF_API_AUTH_METHOD=""
SPLUNK_HF_HOST=""
SPLUNK_HF_MANAGEMENT_PORT=""
SPLUNK_HF_USERNAME=""
SPLUNK_HF_PASSWORD=""
SPLUNK_HF_VERIFY_SSL=""
SPLUNK_HF_TLS_SERVER_NAME=""
SPLUNK_HF_CA_CERT_REMOTE_PATH=""

# Heavy forwarder: separate SSH account; existing key authentication
SPLUNK_HF_SSH_HOST=""
SPLUNK_HF_SSH_PORT=""
SPLUNK_HF_SSH_USERNAME=""
SPLUNK_HF_SSH_AUTH_METHOD=""
SPLUNK_HF_SSH_PASSWORD=""

# Splunk Enterprise: reserved for later
SPLUNK_ENTERPRISE_WEB_URL=""
SPLUNK_ENTERPRISE_API_URL=""
SPLUNK_ENTERPRISE_USERNAME=""
SPLUNK_ENTERPRISE_PASSWORD=""
SPLUNK_ENTERPRISE_SSH_HOST=""
SPLUNK_ENTERPRISE_SSH_USERNAME=""
SPLUNK_ENTERPRISE_SSH_PASSWORD=""
