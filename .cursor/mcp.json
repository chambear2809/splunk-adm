{
  "mcpServers": {
    "splunk-cisco-skills": {
      "type": "stdio",
      "command": "python3",
      "args": [
        "-I",
        "${workspaceFolder}/vendor/splunk-cisco-skills/agent/run-splunk-cisco-skills-mcp.py"
      ],
      "env": {
        "SPLUNK_SKILLS_MCP_ENABLE_EXECUTION": "1",
        "SPLUNK_SKILLS_MCP_ALLOW_GENERIC_EXECUTION": "0",
        "SPLUNK_SKILLS_MCP_ALLOW_MUTATION": "0"
      }
    }
  }
}
